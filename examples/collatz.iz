// how many steps does n take to reach 1?
fn steps(n: Int) -> Int {
    var x = n;
    var count = 0;
    while x != 1 {
        if x % 2 == 0 {
            x = x / 2;
        } else {
            x = 3 * x + 1;
        }
        count = count + 1;
    }
    return count;
}

fn longest(limit: Int) -> Int {
    var best = 1;
    var n = 1;
    while n < limit {
        if steps(n) > steps(best) {
            best = n;
        }
        n = n + 1;
    }
    return best;
}

let winner = longest(10000);
print(winner);
print(steps(winner));
