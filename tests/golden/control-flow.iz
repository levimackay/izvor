fn classify(n: Int) -> Int {
    if n < 0 {
        return -1;
    } else if n == 0 {
        return 0;
    } else {
        return 1;
    }
}

fn boom() -> Bool {
    return 1 / 0 == 0;
}

print(classify(-5));
print(classify(0));
print(classify(99));

print(false && boom());
print(true || boom());

var total = 0;
var i = 1;
while i <= 100 {
    if i % 3 == 0 || i % 5 == 0 {
        total = total + i;
    }
    i = i + 1;
}
print(total);
